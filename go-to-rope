local runService = game:GetService("RunService")
local pathfindingService = game:GetService("PathfindingService")
local workspaceService = game:GetService("Workspace")
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local playerGui = localPlayer:WaitForChild("PlayerGui")

local function f1(position, character, humanoidRootPart)
  local raycastParams = RaycastParams.new()
  raycastParams.FilterDescendantsInstances = { character }
  raycastParams.FilterType = Enum.RaycastFilterType.Exclude

  local raycast = workspaceService:Raycast(position + humanoidRootPart.CFrame.LookVector * 1.5
    + Vector3.new(0, 10, 0), Vector3.new(0, -50, 0), raycastParams)

  if raycast then
    return raycast.Position.Y
  end

  return nil
end

local goToRopeStandaloneGui = Instance.new("ScreenGui")
goToRopeStandaloneGui.Name = "GoToRopeStandaloneGui"
goToRopeStandaloneGui.ResetOnSpawn = false
goToRopeStandaloneGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 200, 0, 50)
mainFrame.Position = UDim2.new(0, 10, 0.5, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = goToRopeStandaloneGui

local goToRopeButton = Instance.new("TextButton")
goToRopeButton.Name = "GoToRopeButton"
goToRopeButton.Size = UDim2.new(1, -10, 0, 32)
goToRopeButton.Position = UDim2.new(0, 5, 0, 9)
goToRopeButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
goToRopeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
goToRopeButton.Font = Enum.Font.GothamBold
goToRopeButton.TextSize = 13
goToRopeButton.Text = "Go to Rope"
goToRopeButton.AutoButtonColor = true
goToRopeButton.Parent = mainFrame

local flag = false
local vector = Vector3.new(-543.26, -2.07, -589.26)
local connect
local v1
local ropeVelocity
local ropeGyro

local function f2()
  flag = false

  if connect then
    connect:Disconnect()
    connect = nil
  end

  if v1 then
    task.cancel(v1)
    v1 = nil
  end

  local character2 = localPlayer.Character

  if character2 then
    local humanoid = character2:FindFirstChildOfClass("Humanoid")

    if humanoid then
      humanoid.PlatformStand = false
    end

    if ropeVelocity then
      ropeVelocity:Destroy()
      ropeVelocity = nil
    end

    if ropeGyro then
      ropeGyro:Destroy()
      ropeGyro = nil
    end
  end
end

local getWaypoints = {}
local v2 = 1
local v3 = 0
local v4 = 0
local mouseButton1Click = goToRopeButton.MouseButton1Click
local position2

mouseButton1Click:Connect(function()
  if flag then
    return
  end

  local character3 = localPlayer.Character

  if not character3 then
    return
  end

  local humanoidRootPart2 = character3:FindFirstChild("HumanoidRootPart")
  local v5 = not humanoidRootPart2
  local humanoid2 = character3:FindFirstChildOfClass("Humanoid")

  if v5 or not humanoid2 then
    return
  end

  flag = true

  goToRopeButton.Text = "Going to Rope..."
  goToRopeButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)

  humanoid2.PlatformStand = true

  ropeVelocity = Instance.new("BodyVelocity")
  ropeVelocity.MaxForce = Vector3.new(1000000, 1000000, 1000000)
  ropeVelocity.Velocity = Vector3.new(0, 0, 0)
  ropeVelocity.Name = "RopeVelocity"
  ropeVelocity.Parent = humanoidRootPart2

  ropeGyro = Instance.new("BodyGyro")
  ropeGyro.MaxTorque = Vector3.new(400000, 1000000, 400000)
  ropeGyro.P = 5000
  ropeGyro.D = 500
  ropeGyro.Name = "RopeGyro"
  ropeGyro.Parent = humanoidRootPart2

-- https://lua-x.online
  getWaypoints = {}
  v2 = 1
  v3 = 0
  position2 = humanoidRootPart2.Position
  v4 = tick()

  connect = runService.Heartbeat:Connect(function()
    if not flag then
      return
    end

    local character4 = localPlayer.Character

    if not character4 then
      return
    end

    local humanoidRootPart3 = character4:FindFirstChild("HumanoidRootPart")

    if not humanoidRootPart3 then
      return
    end

    local position3 = humanoidRootPart3.Position

    if (Vector2.new(position3.X, position3.Z) - Vector2.new(vector.X, vector.Z)).Magnitude <= 5 then
      ropeVelocity.Velocity = Vector3.new(0, 0, 0)
      f2()

      goToRopeButton.Text = "Reached!"
      goToRopeButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
      goToRopeButton.Active = false
      goToRopeButton.AutoButtonColor = false

      return
    end

    local v6 = tick()

    if v6 - v4 >= 0.5 then
      if (position3 - position2).Magnitude < 0.8 then
        v3 = v3 + 1
      else
        v3 = 0
      end

      position2 = position3
      v4 = v6

      if v3 >= 3 then
        ropeVelocity.Velocity = Vector3.new(math.random(-10, 10), 20, math.random(-10, 10))
        task.wait(0.3)
        v3 = 0
        getWaypoints = {}
        return
      end
    end

    local v7 = (f1(position3, character4, humanoidRootPart3) or position3.Y) + 6
    local position4 = vector

    if #getWaypoints > 0 and v2 <= #getWaypoints then
      local v8 = getWaypoints[v2]

      if v8 then
        position4 = v8.Position
      end
    end

    local v9 = position4.Y - position3.Y

    if v9 > 3 then
      v2 = v2 + 1
      return
    end

    if v9 > 0.5 then
      v7 = position3.Y + v9 + 2
    end

    local vector2 = Vector3.new(position4.X, v7, position4.Z)
    local v10 = vector2 - position3

    if v10.Magnitude > 0.2 then
      local vector3 = v10.Unit * 18

      if v10.Y < -2 then
        vector3 = Vector3.new(vector3.X, -35, vector3.Z)
      end

      ropeVelocity.Velocity = vector3
      ropeGyro.CFrame = CFrame.lookAt(position3, Vector3.new(vector2.X, position3.Y, vector2.Z))
    else
      ropeVelocity.Velocity = Vector3.new(0, 0, 0)
    end

    if #getWaypoints > 0 and v2 <= #getWaypoints then
      local position5 = getWaypoints[v2].Position

      if (Vector2.new(position3.X, position3.Z) - Vector2.new(position5.X, position5.Z)).Magnitude
        < 4 then
        v2 = v2 + 1
      end
    end
  end)

  v1 = task.spawn(function()
    local path = pathfindingService:CreatePath({
      AgentRadius = 3,
      AgentHeight = 10,
      AgentCanJump = true,
    })

    while flag do
      local character5 = localPlayer.Character

      if character5 then
        local humanoidRootPart4 = character5:FindFirstChild("HumanoidRootPart")

        if humanoidRootPart4 then
          local ok, result = pcall(function()
            path:ComputeAsync(humanoidRootPart4.Position, vector)
          end)

          if ok and path.Status == Enum.PathStatus.Success then
            getWaypoints = path:GetWaypoints()
            v2 = 2
          end
        end
      end

      task.wait(1)
    end
  end)
end)
