local function getLayoutOrder()
  local mainGui = playerGui:FindFirstChild("MainGui")

  if not mainGui then
    return nil
  end

  local list = mainGui:FindFirstChild("RightPanel")
    and mainGui.RightPanel:FindFirstChild("Inventory")
    and mainGui.RightPanel.Inventory:FindFirstChild("List")

  if not list then
    return nil
  end

  local bluefruit = list:FindFirstChild("Bluefruit")

  if bluefruit then
    return bluefruit.LayoutOrder
  end

  return nil
end

local function f1()
  local mainGui2 = playerGui:FindFirstChild("MainGui")

  if not mainGui2 then
    return 100
  end

  local valueLabel = mainGui2:FindFirstChild("Panels")
    and mainGui2.Panels:FindFirstChild("Stats") and mainGui2.Panels.Stats:FindFirstChild("Bars")
    and mainGui2.Panels.Stats.Bars:FindFirstChild("Hunger")
    and mainGui2.Panels.Stats.Bars.Hunger:FindFirstChild("ValueLabel")

  if valueLabel and valueLabel:IsA("TextLabel") then
    return tonumber(valueLabel.Text) or 100
  end

  return 100
end

task.spawn(function()
