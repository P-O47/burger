local function getEntityID()
  local character = localPlayer.Character

  if not character then
    return nil
  end

  local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

  if not humanoidRootPart then
    return nil
  end

  for _, value in ipairs(workspaceService.Deployables:GetChildren()) do
    if value.Name == "Coin Press" then
      local primaryPart = value.PrimaryPart

      local basePart = primaryPart
      basePart = primaryPart or value:FindFirstChildWhichIsA("BasePart")

      if basePart and (basePart.Position - humanoidRootPart.Position).Magnitude <= 50 then
        return value:GetAttribute("EntityID")
      end
    end
  end

  return nil
end

local mouseButton1Click = coinPressButton.MouseButton1Click
local connect

mouseButton1Click:Connect(function()
  flag = not flag

  if flag then
    coinPressButton.Text = "Coin Press: ON"
    coinPressButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)

    connect = runService.Heartbeat:Connect(function()
      local lastToolUse = v3.getServerTime(true)

      if lastToolUse - (v2.Data.lastToolUse or 0) < 0.016666666666667 then
        return
      end

      local entityID = getEntityID()

      if entityID then
        v2.Data.lastToolUse = lastToolUse
        v1.InteractStructure.send({ entityID = entityID, itemID = 597 })
      end
    end)
  else
    coinPressButton.Text = "Coin Press: OFF"
    coinPressButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

-- https://lua-x.online
    if connect then
      connect:Disconnect()
      connect = nil
    end
  end
end)

